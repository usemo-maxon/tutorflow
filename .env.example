# Public application URLs. Set the canonical HTTPS domain in production.
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Supabase key (new secret key or legacy service-role key).
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# 32 random bytes encoded as base64url, e.g. `openssl rand -base64 32`.
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_BASE64URL_32_BYTE_KEY

# Vercel sends this value as `Authorization: Bearer ...` to cron routes.
CRON_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Google Calendar OAuth web client (server-only secret).
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME

# One centralized Telegram bot.
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_BOT_USERNAME=TutorFlowBot
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_AZaz09_UNDERSCORE_OR_DASH

# PayU REST API. Use https://secure.snd.payu.com for sandbox previews.
PAYU_POS_ID=REPLACE_ME
PAYU_CLIENT_SECRET=REPLACE_ME
PAYU_SECOND_KEY=REPLACE_ME
PAYU_API_BASE_URL=https://secure.payu.com

# Development only. Never configure on Vercel Production.
TUTORFLOW_DATA_DIR=
